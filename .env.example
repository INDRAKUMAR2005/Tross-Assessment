# Server configuration
HOST=0.0.0.0
PORT=8000

# LinkedIn Authentication (Method 1: Cookie-based - RECOMMENDED & MOST STABLE)
# Extract these from your browser after logging into linkedin.com:
# 1. Open Developer Tools (F12) -> Application (Chrome) or Storage (Firefox) -> Cookies -> https://www.linkedin.com
# 2. Copy the value of 'li_at' (long string starting with AQED...)
# 3. Copy the value of 'JSESSIONID' (looks like "ajax:xxxxxxxxxxxxxxxxx" - keep the double quotes if they exist or copy the value inside)
LINKEDIN_LI_AT=your_li_at_cookie_here
LINKEDIN_JSESSIONID="ajax:your_jsessionid_here"

# LinkedIn Authentication (Method 2: Credentials-based - Fallback)
# Note: Programmatic login frequently triggers 2FA or CAPTCHAs, so Method 1 is highly recommended.
LINKEDIN_USERNAME=your_email@example.com
LINKEDIN_PASSWORD=your_secure_password
